# Copier ce fichier en /opt/finances-perso/.env sur le VPS et remplir les valeurs.

# Clé secrète des sessions. Générer avec :  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a-remplacer-par-une-longue-chaine-aleatoire

# Adresse du frontend GitHub Pages (autorisée à appeler l'API)
FRONTEND_ORIGINS=https://tolobayounousaa225-prog.github.io

# Adresse publique de l'API. Sans nom de domaine : api.<IP avec des tirets>.sslip.io
DOMAINE=api.12-34-56-78.sslip.io

# Mode HTTPS : « caddy » si les ports 80/443 sont libres, vide si un Caddy/Nginx existe déjà sur le VPS
COMPOSE_PROFILES=caddy
# Port local de l'API sur le VPS (à changer si 8000 est déjà pris)
PORT_API=8000

# Emails (facultatif : sans SMTP_HOST, les emails sont seulement affichés dans les logs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=moi@gmail.com
SMTP_PASSWORD=mot-de-passe-d-application
SMTP_FROM=Finances Perso <moi@gmail.com>
# Lien « Ouvrir Finances Perso » dans les emails
APP_URL=https://tolobayounousaa225-prog.github.io/finances-perso/
