# Copier ce fichier en .env sur le serveur et remplir les valeurs.
# Générer une clé secrète :  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a-remplacer-par-une-longue-chaine-aleatoire
DOMAINE=finances.mondomaine.com

# Emails (facultatif : sans SMTP_HOST, les emails sont seulement affichés dans les logs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=moi@gmail.com
SMTP_PASSWORD=mot-de-passe-d-application
SMTP_FROM=Finances Perso <moi@gmail.com>
APP_URL=https://finances.mondomaine.com
